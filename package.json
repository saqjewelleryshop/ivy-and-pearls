{
  "name": "ivy-and-pearls",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node server/index.js",
    "build:client": "vite build --outDir dist/client",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist/server",
    "build": "npm run build:client && npm run build:ssr",
    "start": "NODE_ENV=production node server/index.js",
    "check": "node --check server/index.js && node --check server/lib/zq.js && node --check server/lib/supabase.js && node --check server/routes/api.js && node --check server/routes/webhooks.js && node --check server/services/orders.js && node --check server/services/stripe-products.js",
    "audit:seo": "node scripts/seo-audit.mjs",
    "audit:lighthouse": "lhci autorun",
    "test": "node --test tests/unit/*.test.mjs",
    "quality": "npm run check && npm run test && npm run audit:source && npm run audit:seo && npm run build",
    "audit:source": "node scripts/source-audit.mjs"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^3.7.0",
    "@stripe/stripe-js": "^7.9.0",
    "@supabase/supabase-js": "^2.57.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "gsap": "^3.13.0",
    "helmet": "^8.1.0",
    "htmlparser2": "^9.1.0",
    "multer": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.30.1",
    "sanitize-html": "^2.17.0",
    "stripe": "^18.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.1.0",
    "vite": "^5.4.19"
  },
  "engines": {
    "node": ">=20"
  }
}
