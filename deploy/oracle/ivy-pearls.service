[Unit]
Description=Ivy & Pearls React SSR + API
After=network.target

[Service]
Type=simple
User=ivy
WorkingDirectory=/srv/ivy-pearls
Environment=NODE_ENV=production
EnvironmentFile=/srv/ivy-pearls/.env
ExecStart=/usr/bin/node /srv/ivy-pearls/server/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/ivy-pearls

[Install]
WantedBy=multi-user.target
