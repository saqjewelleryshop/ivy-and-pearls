# ------------------------------------------------------------
# Ivy & Pearls — frontend-safe Supabase settings
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://sipkaobshktuikowskzb.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Public site
VITE_SITE_URL=https://ivyandpearls.co.uk
VITE_API_URL=https://api.ivyandpearls.co.uk

# ------------------------------------------------------------
# Server only — NEVER expose these with a VITE_ prefix
# ------------------------------------------------------------
SUPABASE_URL=https://sipkaobshktuikowskzb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_ROTATED_SERVER_SECRET

# Stripe secrets stay server-side. Admin → Payments stores/toggles the
# publishable keys and chooses Test vs Live mode.
STRIPE_TEST_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_TEST_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_LIVE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_LIVE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Legacy fallback supported if you only configure one environment:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

PARTNER_API_KEY=REPLACE_WITH_ROTATED_PARTNER_TOKEN
PARTNER_BASE_URL=REPLACE_WITH_PARTNER_API_BASE_URL
PARTNER_ORIGIN_COUNTRY_CODE=REPLACE_WITH_ORIGIN_COUNTRY_CODE

# Email
RESEND_API_KEY=REPLACE_ME
EMAIL_FROM=Ivy & Pearls <clientcare@ivyandpearls.co.uk>

# Runtime
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://ivyandpearls.co.uk

# Optional client-care chat. Enable only after confirming the bot ID exists.
VITE_ZOCHAT_ENABLED=false
VITE_ZOCHAT_BOT_ID=
