{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/media/(.*)", "dest": "/api/index.js" },
    { "src": "/robots.txt", "dest": "/api/index.js" },
    { "src": "/sitemap.xml", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
